{
  "name": "Assignment Manager for YNU LMS",
  "version": "2.5.0",
  "description": "Manage your homework easily",
  "private": true,
  "scripts": {
    "watch": "webpack --mode=development --watch --config config/webpack.config.js",
    "build": "webpack --mode=production --config config/webpack.config.js",
    "format": "prettier --write --ignore-unknown \"{config,public,src,tests}/**/*.{html,css,js,mjs,ts,json}\"",
    "format:check": "prettier --check --ignore-unknown \"{config,public,src,tests}/**/*.{html,css,js,mjs,ts,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/chrome": "^0.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "file-loader": "^6.2.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.5",
    "ts-loader": "^9.6.2",
    "tsx": "4.23.1",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.64.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.0.0",
    "webpack-merge": "^6.0.0"
  },
  "dependencies": {
    "gridjs": "^6.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,md}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.19.0 <12.0.0",
      "onFail": "download"
    },
    "runtime": [
      {
        "name": "node",
        "version": "^24.18.0",
        "onFail": "download"
      }
    ]
  }
}
